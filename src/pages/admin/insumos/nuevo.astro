---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import InsumoForm from '../../../components/admin/InsumoForm.tsx';
---

<AdminLayout>
  <div class="max-w-2xl">
    <div class="mb-8">
      <a href="/admin/insumos" class="text-sm text-zinc-500 hover:text-white transition-colors">&larr; Volver al inventario</a>
      <h1 class="text-2xl font-bold text-white mt-2">Nuevo insumo</h1>
      <p class="text-sm text-zinc-500 mt-1">Registra un nuevo insumo en el inventario</p>
    </div>
    <InsumoForm client:load />
  </div>
</AdminLayout>
