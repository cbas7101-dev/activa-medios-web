---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PublicationForm from '../../../components/admin/PublicationForm.tsx';
---

<AdminLayout>
  <div class="max-w-2xl">
    <div class="mb-8">
      <a href="/admin/publicaciones" class="text-sm text-zinc-500 hover:text-white transition-colors">&larr; Volver a publicaciones</a>
      <h1 class="text-2xl font-bold text-white mt-2">Nueva publicación</h1>
      <p class="text-sm text-zinc-500 mt-1">Crea una publicación para redes sociales</p>
    </div>
    <PublicationForm client:load />
  </div>
</AdminLayout>
